#!/usr/bin/env bash
# 真闸门：push 前跑测试，红了不让推。
#
# 为什么在这一层：这个仓 push 即部署（Pages branch-deploy），GitHub Actions 与部署并行，
# 坏提交永远是"先上线、后报警"。CI 是告警，这个 hook 才是闸门。
#
# 启用（fork 走的人做一次）：git config core.hooksPath .githooks
# 逃生门：git push --no-verify（自己知道在干嘛的时候用，比如推纯文档的紧急修复）
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# 这次 push 实际带过去的文件。基准必须取自「推去哪」——git 从 stdin 逐行喂
#   <本地ref> <本地sha> <远端ref> <远端sha>
# 远端 sha 就是目标分支此刻的位置，正是该比的基准。
#
# 旧写法拿「当前分支名」去猜同名远端分支，源≠分支名的推送必猜错。2026-08-02 实伤：
# 先推 fix/touch-annotate、再 `git push origin HEAD:main`，第二次比的是「我的分支 vs 一秒前
# 刚推上去的同名副本」= 空 diff → 判成纯文档 → 浏览器层整个跳过，一次改 ui.js 的提交
# 直奔生产没过闸。算不出增量时一律当全改了：这道闸门只许往严的方向倒。
is_zero() { [[ "$1" =~ ^0+$ ]]; }
CHANGED=""
NREF=0
WIDEN=0
# 旧词闸门的排除区：这几个文件按设计就该留着旧词——改名脚本的映射表本身是数据，
# 另外三张是历史表格（账本、已定问题），记的就是当天拍板时的措辞。
# 本文件自己也要排除：下面那行 LEGACY_RE 的模式定义就是一串旧词，不排除就自己咬自己
# （2026-08-06 实测撞到：第一次 push 被自己拦住）。
LEGACY_SKIP=(':(exclude).githooks/pre-push' ':(exclude)tang-rename.py'
             ':(exclude)MIGRATION-WATCH.zh-CN.md'
             ':(exclude)OPEN-QUESTIONS.md' ':(exclude)OPEN-QUESTIONS.zh-CN.md')
ADDED=""
while read -r _lref lsha _rref rsha; do
  [ -z "${lsha:-}" ] && continue
  is_zero "$lsha" && continue                      # 删远端分支：没内容可测
  NREF=$((NREF + 1))
  if ! is_zero "$rsha" && git cat-file -e "${rsha}^{commit}" 2>/dev/null; then
    CHANGED+="$(git diff --name-only "$rsha" "$lsha")"$'\n'
    ADDED+="$(git diff "$rsha" "$lsha" -- . "${LEGACY_SKIP[@]}" | grep '^+' || true)"$'\n'
  else
    WIDEN=1                                        # 新建远端分支 / 本地没这个对象：算不出增量
  fi
done
if [ "$NREF" -eq 0 ] || [ "$WIDEN" -eq 1 ]; then
  CHANGED="$(git ls-files)"
fi

# 只动文档就别跑 90 秒的浏览器层——闸门要挡的是代码，不是错别字
CODE_TOUCHED="$(echo "$CHANGED" | grep -E '^(src/|index\.html|vendor/|test/|\.githooks/)' || true)"

# 供 test/prepush.test.js 验分类：只报判定，不跑那 90 秒
if [ -n "${PREPUSH_DRYRUN:-}" ]; then
  [ -z "$CODE_TOUCHED" ] && echo "DRYRUN docs-only" || echo "DRYRUN code"
  exit 0
fi

echo "── pre-push 闸门 ──"

# 旧词闸门（2026-08-06 立）。病史：7/31 唐制改名把「档案文档」整体排除，规矩写的是
# 「档案不追改，历史该留着旧称」——被读成整份文档都别动，于是 SPEC/BACKLOG/OPEN-QUESTIONS
# 带着 134 处旧词在 GitHub 上活了 6 天，直到 Charlie 自己读 PAIN.md 读懵才发现。
# 当时没有任何东西在拦。这就是那个"任何东西"。
#
# 只看本次新增的行：存量已分类清完，剩下的是协议串与历史叙述，反复报只会教人忽略闸门。
LEGACY_RE='朱批|奏折|钦此|总批|待批|御笔'
LEGACY_OK='旧词|legacy term|原文存档|original text preserved|存账|存拍板|改成定稿词|已改|changed 7/31|改名时漏改|唐制统一|Tang-dynasty terms'
if [ "$NREF" -eq 0 ] || [ "$WIDEN" -eq 1 ]; then
  # 算不出增量就扫全仓（与上面同一条纪律：只许往严的方向倒）
  echo "  旧词闸门：算不出本次增量，改扫全仓"
  LEGACY_HITS="$(git grep -nE "$LEGACY_RE" HEAD -- . "${LEGACY_SKIP[@]}" 2>/dev/null | grep -vE "$LEGACY_OK" || true)"
else
  LEGACY_HITS="$(printf '%s' "$ADDED" | grep -E "$LEGACY_RE" | grep -vE "$LEGACY_OK" || true)"
fi
if [ -n "$LEGACY_HITS" ]; then
  echo "✖ 新增内容里有 7/31 已废的旧词，push 中止："
  printf '%s\n' "$LEGACY_HITS" | head -12 | sed 's/^/    /'
  echo "  现役词：门下 · 敕草 · 涂归 · 判 · 画可 · 待审"
  echo "  真要记历史（当时屏幕上是哪几个字），同一行写上「旧词」二字即放行。"
  echo "  确要推：git push --no-verify"
  exit 1
fi
echo "✔ 旧词闸门通过"
# 量测随每次 push 打脸：账本停摆过 7 个 commit，根因是记账没有触发点。
# 量 HEAD 不量工作树——这行是 MIGRATION-WATCH 的数据源，脏树上量出来的数会说谎（第七轮评审）。
# #1 看「最大单文件」而非写死 ui.js：拆出 components/ 后，写死会让下一个养到 800 行的文件永不触发。
BIG_FILE=$(git ls-tree -r HEAD --name-only \
  | grep -E '^(src/.*\.js|index\.html)$' \
  | while read -r f; do echo "$(git show "HEAD:$f" | wc -l | tr -d ' ') $f"; done \
  | sort -rn | head -1)
BIG=${BIG_FILE%% *}
TOTAL=$(git ls-tree -r HEAD --name-only \
  | grep -E '^(src/.*\.(js|css)|index\.html)$' \
  | while read -r f; do git show "HEAD:$f"; done | wc -l | tr -d ' ')
echo "量测（HEAD·仅趋势）：最大单文件 ${BIG_FILE} · 全量 ${TOTAL} 行"
# #1/#2 于 2026-07-28 降级为描述性统计（SPEC §8.1）：拆组件让复杂度降、行数升，
# 指标与目标反向，且行数类从未预测过任何 bug。这里只打印看趋势，不再报「触发」。
# 真正的闸门是 #3/#5/#8/#9（视图层复杂度）与 §8.2 的 S1–S4（要不要活体依赖）。

if [ -z "$CODE_TOUCHED" ]; then
  echo "本次只动文档，跑单元层即可（代码层跳过）"
  if ! node --test test/*.test.js >/tmp/zhupi-prepush.log 2>&1; then
    tail -20 /tmp/zhupi-prepush.log
    echo "✖ 单元测试红了，push 中止。（确要推：git push --no-verify）"
    exit 1
  fi
  grep -qE '[[:space:]]tests[[:space:]]+[1-9]' /tmp/zhupi-prepush.log || {
    echo "✖ 一个测试都没跑到（glob 落空？），push 中止。"; exit 1; }
  echo "✔ 单元层通过，放行"
  exit 0
fi

echo "本次动了代码，全量跑（约 90 秒；纯文档 push 会自动跳过这段）"
if ! ./test/run.sh >/tmp/zhupi-prepush.log 2>&1; then
  echo "── 失败详情 ──"
  grep -E '✖|FAIL|not ok|✖ ' /tmp/zhupi-prepush.log | head -20
  echo "（完整日志 /tmp/zhupi-prepush.log）"
  echo "✖ 测试红了，push 中止——这个仓 push 即部署，不让坏代码先上线。"
  echo "  确要推：git push --no-verify"
  exit 1
fi
echo "✔ 全部通过（unit + dom + smoke + 故障注入），放行"
